# Safe local defaults. Copy to .env.local only when you need overrides.
REACT_APP_DATA_MODE=fixture
REACT_APP_LOCATION_MODE=fixture
REACT_APP_FIXED_LAT=25.033
REACT_APP_FIXED_LON=121.5654
REACT_APP_FIXTURE_COUNT=100
REACT_APP_FIXTURE_ACTIVE_COUNT=10
REACT_APP_FIXTURE_MOTION=false
REACT_APP_FIXTURE_MOTION_INTERVAL=1500

# Exhibition output is opt-in. `npm run start:exhibition` applies the client,
# loopback URL, and OSC-on values below without editing this file.
REACT_APP_SOCKET_MODE=off
REACT_APP_SOCKET_URL=http://127.0.0.1:3001
REACT_APP_OSC_OUTPUT=off
REACT_APP_SHOW_DIAGNOSTICS=true

# Firebase has no defaults. Use a staging project for development.
REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN=
REACT_APP_FIREBASE_DATABASE_URL=
REACT_APP_FIREBASE_PROJECT_ID=
REACT_APP_FIREBASE_STORAGE_BUCKET=
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=
REACT_APP_FIREBASE_APP_ID=
